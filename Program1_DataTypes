//Datatypes
/*
1.string - store text data
2.Number - stores int and float values (alpha numeric)
3.Bolean - stores true or false
4.Null - when you dont want to give any data
5.undefined - variable is declared but value have not assigned yet.
6. Bigit - the big number type adding n suffix
7. symbol - stores special and unique values
*/
 
let age = 25;
console.log(age);
console.log(typeof age) //number

const name = "Krupa";
console.log(name);
console.log(typeof name); //string

var Isdisable = true;
console.log("User is disabled ", Isdisable + typeof Isdisable); //boolean

var studentName = null;
console.log(typeof studentName); //object

let cityName;
console.log(typeof cityName); //undefined

